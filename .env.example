# Secret for signing session cookies (Netlify Functions). On Netlify it is set under
# Site configuration > Environment variables. For `netlify dev`, copy this file to .env
# and put any long random string here, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated emails of the accounts that may open /moderate (the queue of flagged reports).
# Leave empty and nobody is a moderator.
MODERATOR_EMAILS=
